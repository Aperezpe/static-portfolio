{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Personal Portfolio",
  "main": "js/main.js",
  "scripts": {
    "sass": "sass sass/main.scss css/style.css --no-source-map --style=compressed",
    "sass:watch": "sass sass/main.scss css/style.css --no-source-map --watch",
    "start": "npm run sass && (npm run sass:watch & eleventy --serve)",
    "build": "npm run sass && eleventy"
  },
  "author": "Abraham",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "luxon": "^3.7.2",
    "sass": "^1.105.1"
  }
}
