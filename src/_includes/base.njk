{%- set d = portfolioData -%}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ d.name }} · {{ d.role }}</title>
    <meta name="description" content="{{ d.introText }}">
    <meta name="theme-color" content="#1f0544">

    <meta property="og:title" content="{{ d.name }} · {{ d.role }}">
    <meta property="og:description" content="{{ d.introText }}">
    <meta property="og:image" content="https://portfolio.abperez.com/assets/img/Thumbnail.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="627">
    <meta property="og:url" content="https://portfolio.abperez.com">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" href="/assets/img/favicon-16x16.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Nunito:wght@700;800;900&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <script src="https://kit.fontawesome.com/46ee3dcf79.js" crossorigin="anonymous" defer></script>
    <script>
        // Runs before paint so hidden-until-revealed content and the one-time splash never flash.
        document.documentElement.classList.add("js");
        try {
            if (sessionStorage.getItem("splash-seen")) {
                document.documentElement.classList.add("seen");
                document.documentElement.style.setProperty("--splash", "0s");
            }
            sessionStorage.setItem("splash-seen", "1");
        } catch (e) {}
    </script>
    <script src="/js/main.js" defer></script>
</head>

<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="splash" aria-hidden="true">
        <img class="splash__logo" src="/assets/img/LogoAP_logo.png" alt="">
    </div>

    <div class="spotlight" aria-hidden="true"></div>

    <header class="nav" id="nav">
        <a class="nav__logo" href="#top" aria-label="Back to top">
            <img src="/assets/img/LogoAP_logo.png" alt="Abraham Perez logo" width="98" height="75">
        </a>

        <button class="nav__toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
            <span></span>
        </button>

        <nav class="nav__menu" id="nav-menu" aria-label="Primary">
            <ol class="nav__list">
                <li><a class="nav__link" href="#about">About</a></li>
                <li><a class="nav__link" href="#experience">Experience</a></li>
                <li><a class="nav__link" href="#work">Work</a></li>
                <li><a class="nav__link" href="#contact">Contact</a></li>
            </ol>
            <a class="btn btn--small" href="{{ d.resumeUrl }}" target="_blank" rel="noopener">Resume</a>
        </nav>
    </header>

    <main id="main">
        <section class="hero" id="top">
            {%- set current = d.experience[0] -%}
            <a class="hero__status reveal" href="{{ current.companyUrl }}" target="_blank" rel="noopener">
                <span class="pulse" aria-hidden="true"></span>
                {{ current.title }} @ {{ current.companyName }}
            </a>
            <p class="hero__hello reveal">Hi, my name is</p>
            <h1 class="hero__name reveal">{{ d.name }}.</h1>
            <h2 class="hero__tagline reveal">{{ d.tagline }}</h2>
            <p class="hero__intro reveal">{{ d.introText }}</p>
            <div class="hero__actions reveal">
                <a class="btn btn--large" href="mailto:{{ d.email }}">Say hello</a>
                <a class="btn btn--large btn--ghost" href="#work">See my work <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
            </div>
        </section>

        <section class="section" id="about">
            <h2 class="section__title reveal">About me</h2>

            <div class="about">
                <div class="about__content reveal">
                    {% for text in d.aboutMeText %}
                    <p>{{ text }}</p>
                    {% endfor %}
                    <ul class="skills">
                        {% for skill in d.aboutMeSkills %}
                        <li>{{ skill }}</li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="about__photo reveal">
                    <div class="tinted">
                        <img src="/assets/img/headshot-900.jpg" alt="Portrait of Abraham Perez" width="796" height="900" loading="lazy">
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="experience">
            <h2 class="section__title reveal">Where I've worked</h2>

            <div class="tabs reveal">
                <div class="tabs__list" role="tablist" aria-label="Job history">
                    {% for job in d.experience %}
                    <button class="tabs__tab" role="tab" id="tab-{{ loop.index0 }}" aria-controls="panel-{{ loop.index0 }}"
                        aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">
                        <span class="tabs__company">{{ job.companyName }}</span>
                        <span class="tabs__year">{{ job.startDate | yearOf }}–{% if job.endDate %}{{ job.endDate | yearOf }}{% else %}Now{% endif %}</span>
                    </button>
                    {% endfor %}
                    <span class="tabs__indicator" aria-hidden="true"></span>
                </div>

                <div class="tabs__panels">
                    {% for job in d.experience %}
                    <div class="tabs__panel" role="tabpanel" id="panel-{{ loop.index0 }}" aria-labelledby="tab-{{ loop.index0 }}" tabindex="0" {% if not loop.first %}hidden{% endif %}>
                        <h3 class="job__title">
                            {{ job.title }}
                            <a href="{{ job.companyUrl }}" target="_blank" rel="noopener">@ {{ job.companyName }}</a>
                        </h3>
                        <p class="job__dates">
                            {{ job.startDate | niceDate }} – {% if job.endDate %}{{ job.endDate | niceDate }}{% else %}Present{% endif %}
                            <span>· {{ job.startDate | duration(job.endDate) }}</span>
                        </p>
                        <ul class="arrow-list">
                            {% for item in job.responsabilities %}
                            <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="section" id="work">
            <h2 class="section__title reveal">Some things I've built</h2>

            <ul class="featured">
                {% for project in d.work | selectattr("featuredProject") %}
                <li class="featured__item {% if loop.index is even %}featured__item--flip{% endif %} reveal">
                    <a class="featured__media" href="{{ project.links.self }}" {% if project.links.self.startsWith('http') %}target="_blank" rel="noopener"{% endif %} tabindex="-1" aria-hidden="true">
                        <img src="{{ project.imgUrl }}" alt="" loading="lazy">
                    </a>
                    <div class="featured__content">
                        <p class="eyebrow">Featured project{% if project.badge %} <span class="badge">{{ project.badge }}</span>{% endif %}</p>
                        <h3 class="featured__title">
                            <a href="{{ project.links.self }}" {% if project.links.self.startsWith('http') %}target="_blank" rel="noopener"{% endif %}>{{ project.title }}</a>
                        </h3>
                        <div class="featured__desc"><p>{{ project.description }}</p></div>
                        <ul class="stack">
                            {% for item in project.stack %}<li>{{ item }}</li>{% endfor %}
                        </ul>
                        <div class="featured__links">
                            {% for key, url in project.links %}{% if key != "self" or not project.links.git %}{% projectLink project.title, key, url %}{% endif %}{% endfor %}
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>

        <section class="section section--narrow" id="other-projects">
            <h2 class="section__subtitle reveal">Other noteworthy projects</h2>

            <ul class="cards" id="cards">
                {% for project in d.work | rejectattr("featuredProject") %}
                <li class="card reveal {% if loop.index > 6 %}card--extra{% endif %}">
                    <div class="card__top">
                        <i class="fa-regular fa-folder card__folder" aria-hidden="true"></i>
                        <div class="card__links">
                            {% for key, url in project.links %}{% projectLink project.title, key, url %}{% endfor %}
                        </div>
                    </div>
                    <h3 class="card__title">
                        <a href="{{ project.links.self or project.links.git }}" target="_blank" rel="noopener">{{ project.title }}</a>
                    </h3>
                    <p class="card__desc">{{ project.description }}</p>
                    <ul class="stack stack--card">
                        {% for item in project.stack %}<li>{{ item }}</li>{% endfor %}
                    </ul>
                </li>
                {% endfor %}
            </ul>

            {% if (d.work | rejectattr("featuredProject") | length) > 6 %}
            <button class="btn btn--large cards__more" id="cards-more" aria-expanded="false">Show more</button>
            {% endif %}
        </section>

        <section class="section section--center" id="contact">
            <p class="section__kicker reveal">What's next?</p>
            <h2 class="contact__title reveal">Get in touch</h2>
            <p class="contact__text reveal">{{ d.getInTouchText }}</p>
            <a class="btn btn--large reveal" href="mailto:{{ d.email }}">Say hello</a>
        </section>
    </main>

    <aside class="rail rail--left" aria-label="Social links">
        <ul>
            <li><a href="{{ d.git }}" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a></li>
            <li><a href="{{ d.linkedIn }}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a></li>
        </ul>
    </aside>

    <aside class="rail rail--right" aria-label="Email">
        <a class="rail__email" href="mailto:{{ d.email }}">{{ d.email }}</a>
    </aside>

    <footer class="footer">
        <ul class="footer__social">
            <li><a href="{{ d.git }}" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a></li>
            <li><a href="{{ d.linkedIn }}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a></li>
            <li><a href="mailto:{{ d.email }}" aria-label="Email"><i class="fa-regular fa-envelope" aria-hidden="true"></i></a></li>
        </ul>
        <a class="footer__credit" href="{{ d.portfolioRepoUrl }}" target="_blank" rel="noopener">
            Design inspired by Brittany Chiang · Built by Abraham Perez · {{ "" | year }}
        </a>
    </footer>
</body>

</html>
